# Local dev: Vite proxies /api → backend (see vite.config.js)
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# Production builds use .env.production (https://api.dater.social).
# Do not point VITE_API_BASE_URL at a raw IP or http:// URL — Hostinger serves the site over HTTPS.

# SEO_ORIGIN — optional on Hostinger PHP (public/index.php). Defaults to https://api.dater.social
# SEO_ORIGIN=https://api.dater.social
