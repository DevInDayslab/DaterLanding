# Local dev: Vite proxies /api → backend (see vite.config.js)
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# Production (Vercel / Hostinger): defaults to https://api.dater.social if unset at build time.
# Set explicitly when building for Hostinger (hPanel Git deploy or local build before upload):
# VITE_API_BASE_URL=https://api.dater.social

# SEO_ORIGIN — Vercel middleware only (middleware.js). Not used on Hostinger static hosting.
